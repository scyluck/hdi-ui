{
  "name": "hdi-ui",
  "version": "0.1.0",
  "description": "公司统一前端 UI 框架 - Vue3 + Element Plus + TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/components/*.vue.d.ts",
      "import": "./dist/icons/components/*.js",
      "require": "./dist/icons/components/*.cjs"
    },
    "./components/Icon": {
      "types": "./dist/components/Icon/index.d.ts",
      "import": "./dist/components/Icon.js",
      "require": "./dist/components/Icon.cjs"
    },
    "./components/Dictionary": {
      "types": "./dist/components/Dictionary/index.d.ts",
      "import": "./dist/components/Dictionary.js",
      "require": "./dist/components/Dictionary.cjs"
    },
    "./components/Form": {
      "types": "./dist/components/Form/index.d.ts",
      "import": "./dist/components/Form.js",
      "require": "./dist/components/Form.cjs"
    },
    "./components/FormDialog": {
      "types": "./dist/components/FormDialog/index.d.ts",
      "import": "./dist/components/FormDialog.js",
      "require": "./dist/components/FormDialog.cjs"
    },
    "./components/Permission": {
      "types": "./dist/components/Permission/index.d.ts",
      "import": "./dist/components/Permission.js",
      "require": "./dist/components/Permission.cjs"
    },
    "./components/Table": {
      "types": "./dist/components/Table/index.d.ts",
      "import": "./dist/components/Table.js",
      "require": "./dist/components/Table.cjs"
    },
    "./components/CardList": {
      "types": "./dist/components/CardList/index.d.ts",
      "import": "./dist/components/CardList.js",
      "require": "./dist/components/CardList.cjs"
    },
    "./components/InfiniteScroll": {
      "types": "./dist/components/InfiniteScroll/index.d.ts",
      "import": "./dist/components/InfiniteScroll.js",
      "require": "./dist/components/InfiniteScroll.cjs"
    },
    "./directives": {
      "types": "./dist/directives/index.d.ts",
      "import": "./dist/directives.js",
      "require": "./dist/directives.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers/index.js",
      "require": "./dist/resolvers/index.cjs"
    },
    "./vite": {
      "types": "./dist/resolvers/vite.d.ts",
      "import": "./dist/resolvers/vite.js",
      "require": "./dist/resolvers/vite.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scyluck/hdi-ui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:icons && npm run typecheck && vite build",
    "build:release": "npm run build -- --mode release && npm run build:umd && npm run sync:cdn",
    "build:umd": "npm run build:icons-umd && npm run build:full-umd",
    "build:icons-umd": "vite build --config vite.icons.umd.config.ts",
    "build:full-umd": "vite build --config vite.full.umd.config.ts",
    "sync:cdn": "node scripts/sync-cdn.mjs",
    "generate:icons": "tsx scripts/generate-icons.ts && node scripts/generate-docs-icons-data.mjs",
    "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/hdi-ui/vue-tsc.tsbuildinfo",
    "test:icons": "tsx --test scripts/generate-icons.test.ts",
    "test:directives": "tsx --test scripts/directives-plugin.test.ts",
    "test:permission": "tsx --test scripts/permission.test.ts",
    "test:dictionary": "tsx --test scripts/dictionary.test.ts",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build:release"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "element-plus": "^2.8.8",
    "sass": "^1.81.0",
    "svgo": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "keywords": [
    "vue3",
    "element-plus",
    "ui-framework",
    "icons"
  ],
  "license": "MIT"
}
